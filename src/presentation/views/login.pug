extends layout

include mixins/_loginForm
include mixins/_forgotForm

block content
    .container
        h2 Log in
        +loginForm()
        h2(style='padding-top:20px') I forgot my password
        +forgotForm()
mixin loginForm()
    form.form(action='/login' method='POST' enctype='application/x-wwwform-urlencoded')
        .mb-3
            label(for="email" class="form-label") Email Address
            input(class="form-control" type="email" name="email")
        .mb-3
            label(for="password" class="form-label") Password
            input(class="form-control" type="password" name="password")
        button(type="submit" class="btn btn-primary") Log in